# ==============================================================================
# StaffPay Cloud Sync & Multi-Device Configuration
# ==============================================================================

# 1. Google Firebase (Recommended for ₹0 Cost & Instant Multi-Device Sync)
# ------------------------------------------------------------------------------
# Steps to get your free credentials:
# 1. Go to https://console.firebase.google.com/
# 2. Click "Create a project" (e.g. StaffPay)
# 3. In project overview, click "</>" (Web) to register your web app
# 4. Copy the firebaseConfig values and paste them below:

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 2. Google OAuth 2.0 Client ID (Optional Google Drive fallback)
# ------------------------------------------------------------------------------
VITE_GOOGLE_CLIENT_ID=275220713749-1an02q21hv7f9m39rc2p9fdkugrgtsdn.apps.googleusercontent.com
